# VICA 환경변수 템플릿. 실제 값은 .env 에 넣는다 (git 에 올리지 않음).

# ===== LLM (기본: Ollama Cloud — Jetson 온디바이스에서도 주 모델로 사용) =====
OLLAMA_HOST=https://ollama.com
VICA_LLM_MODEL=gemma4:cloud
OLLAMA_API_KEY=여기에_ollama_cloud_키

# ===== (선택) 오프라인/폴백용 로컬 Ollama — 위 3줄 대신 아래로 =====
# OLLAMA_HOST=http://localhost:11434
# VICA_LLM_MODEL=gemma4:e2b
# (로컬 Ollama 는 인증이 없으므로 OLLAMA_API_KEY 를 비워두거나 지운다)

# ===== (선택) OpenAI 백엔드 — 2026-08-15 실측 근거로 도입 검토 중 =====
# (VICA_LLM_MODEL 은 ollama 전용이라 그대로 둬도 된다. openai 모델은 아래 변수)
# VICA_LLM_PROVIDER=openai
# VICA_OPENAI_MODEL=gpt-5.4-mini
# OPENAI_API_KEY=여기에_openai_키

# ===== (선택) 로컬 폴백 — 클라우드가 닿지 않으면 젯슨 안의 Ollama 모델로 자동 전환 =====
# 비우면 폴백이 꺼진다(클라우드 실패 = 고정 멘트). 모델은 scripts/setup_local_llm.sh 로 만든다.
# VICA_LLM_FALLBACK_MODEL=gemma4-e2b-text
# VICA_LLM_FALLBACK_HOST=http://localhost:11434
# VICA_LLM_CLOUD_TIMEOUT=6          # 초. 폴백이 켜졌을 때만 적용, 재시도 없음
# VICA_LLM_CLOUD_PROBE_SEC=30       # 로컬 상태에서 클라우드 확인 간격(초)
# VICA_LLM_LOCAL_TIMEOUT=45          # 초. 로컬 Ollama 호출 상한

# ===== (실험) 소리→의도 직행 — Realtime 이 발화 소리에서 바로 의도를 정한다 (2026-09-20) =====
# VICA_INTENT_INPUT=audio              # text(기본)=지금 방식. audio=Realtime 직행 + 텍스트 경로는 실패 때 예비
# VICA_REALTIME_MODEL=gpt-realtime-2.1-mini
# VICA_REALTIME_TIMEOUT=8              # 초. 넘기면 그 발화는 텍스트 경로가 처리
# VICA_AB_SHADOW=on                    # 기본 꺼짐. 켜면 같은 발화를 텍스트 경로(GPT)로도 판단해 [A/B] 로그에 비교를 남긴다

# ===== 실행 옵션 (main.py) =====
# VICA_TTS=1   # 음성 출력 켜기 (0 이면 텍스트만)
# VICA_STT=0   # 마이크 입력 켜기 (1 이면 STT)

# ===== STT(whisper) 옵션 (기본값은 Jetson 온디바이스 GPU) =====
# VICA_STT_MODEL=small       # tiny/base/small/medium (클수록 정확·느림)
# VICA_VERIFY_STT_MODEL=small   # 긴급(멈춰) 확인 전용 whisper. 귀의 대화 받아쓰기는 VICA_STT_MODEL 을 따른다(2026-10-12)
# VICA_EMERGENCY_SINGLE_FRAME=0.5  # 긴급 모델 한 조각 문턱. off 면 0.5 2연속 규칙만(2026-10-12)
# VICA_LISTEN_MIN_RMS=0.008  # 수음 최소 크기(청취 창 전체 rms). 마이크 점검기가 시연장에서 바꿔 적는다(2026-10-12)
# VICA_SHORT_ANSWER_MIN_RMS=0.02  # 질문 창 짧은 답("네") 구제 최소 크기. 수음 최소의 1.5배 이상(2026-10-12)
# VICA_ESTOP_CLIP_DIR=~/vica_data/estop_clips  # 긴급 관문 소리 저장 폴더. off 면 저장 안 함(2026-10-12)
# VICA_LISTEN_CLIP_DIR=~/vica_data/listen_clips  # 청취 창 말소리를 통과·기각 모두 wav + clips.jsonl 로 저장. 줄이 없으면 이 폴더(기본 켬), off 면 끔(2026-10-21)
# VICA_LISTEN_BAND_MIN=0.004  # 청취 창 말 시작·말끝에서 칩이 말이라 해도 400~3000 Hz 크기가 이보다 작으면 침묵(바람·기계음). 줄이 없으면 0.004, off 면 끔(2026-10-21, 칩 ×4 기준)
# VICA_MIC_AGC_MAX_GAIN=2  # 칩 자동 증폭 한도(공장 ×31.6). ×2 면 2~3 m 옆사람 잡담이 수음 최소 아래로 — 줄이 없으면 쓰지 않음(2026-10-15)
# VICA_APPROACH_MIN_RMS=0.006  # 접근 질문 대답만의 수음 최소 — 로봇 앞 1 m 넘게 떨어진 대답. 줄이 없으면 수음 최소 그대로(2026-10-15)
# VICA_STT_DEVICE=cuda       # 기본 cuda. CUDA 미가용 시 자동 CPU 폴백
# VICA_STT_COMPUTE=float16   # 기본 float16. CPU 폴백 시 int8 권장

# ===== 귀 받아쓰기 엔진 — whisper 대신 Qwen3-ASR(transcribe.cpp) (2026-10-15) =====
# 역할별로 고른다. 기본 whisper. qwen 인데 못 올리면 whisper 로 되돌아가지 않고 귀(vica_wakeword)가 멈춘다.
# 설계: docs/superpowers/specs/2026-10-15-stt-qwen-asr-design.md
# VICA_STT_ENGINE=whisper          # 대화·질문 창: whisper | qwen
# VICA_VERIFY_STT_ENGINE=whisper   # '멈춰' 확인: whisper | qwen
# VICA_QWEN_MODEL=~/tools/models/qwen3asr/Qwen3-ASR-1.7B-Q8_0.gguf
# VICA_TRANSCRIBE_LIB=~/tools/transcribe.cpp/build-shared/src/libtranscribe.so.0.4.0
# VICA_TRANSCRIBE_PY=~/tools/transcribe.cpp/bindings/python/src
# VICA_QWEN_THREADS=4              # CPU 스레드(라이브러리 기본은 8 — 젯슨은 CPU 가 병목)

# 건물 디렉터리(다른 층 장소, P1). 없으면 모델은 이 층만 안다.
VICA_DIRECTORY_YAML=~/vica_data/destinations/directory.yaml

# ===== 호출 방향 회전 ("비카야" 쪽으로 몸 돌리기, docs/beamforming_doa_facts.md) =====
# 기본 off (2026-10-06 팀 요청 — 마이크 잡음이 강한 곳에서 방향이 틀려 엉뚱한 쪽으로 돌았다).
# on 이면 호출 방향을 미션에 보내 그쪽으로 돈다(손잡이 쪽이면 돌지 않고 바로 질문).
# 앱 대시보드 '빔포밍 회전' 스위치(2026-11-19)가 /vica/wake_doa_turn/enable 로 실행 중 바꾼다.
# 음성을 다시 띄우면 이 값으로 돌아간다.
# VICA_WAKE_DOA_TURN=off

# ===== 사람 접근 차임 (2026-10-07) =====
# 시각장애인에게 다가가는 동안(미션 dialog_state=approaching) 2초마다 종 두 음 "딩—동↗".
# 첫 인사 "동행로봇 비카가 다가가고 있어요"는 미션이 말한다. off 면 차임만 끈다.
# VICA_APPROACH_CHIME=on
# 차임 최고점(dBFS). 말은 -3. 크면 -9, 작으면 -15 처럼 현장에서 맞춘다.
# VICA_APPROACH_CHIME_DBFS=-12

# ===== "비카야" 응답 주체 (2026-10-07, 호출 반응표) =====
# on(기본): 이 저장소는 호출만 알리고, 미션이 상태를 보고 "네?"·대답 여부를 정한다
# (/vica/wake_reply listen·ignore). 미션 저장소와 같은 날 올린다.
# off: 옛 방식 — 웨이크워드 노드가 상태와 상관없이 직접 "네?"를 하고 듣는다(미션을 옛 판으로 돌릴 때).
# VICA_WAKE_BY_MISSION=on
# 미션 판정을 기다리는 상한(초). 넘기면 미션이 멈춘 것으로 보고 호출 창의 말을 버린다.
# VICA_WAKE_REPLY_TIMEOUT_SEC=6.0

# ===== 세션 주인 목소리 따라가기 (2026-11-11 설계 docs/superpowers/specs/2026-11-11-speaker-follow-design.md) =====
# off = 끔 · log = 기록만 · on = 거르기 + 대기 중 본인 확인(미션도 /vica/speaker_mode 로 자동으로 켜짐)
# VICA_SPK_FOLLOW=off
# VICA_SPK_MODEL=~/vica_data/spk_eval/models/3dspeaker_speech_eres2net_sv_en_voxceleb_16k.onnx
# VICA_SPK_TH_WAKE=0.55     # "비카야"+발화 문턱(11-10 측정: A 36/36·남 0/108)
# VICA_SPK_TH=0.50          # 발화만 문턱(질문 답 창)
# VICA_SPK_SHORT_SEC=1.0    # 이보다 짧은 말은 안내 중 거르지 않는다(D13)
# 손잡이 부채꼴은 VICA_USER_DOA_CENTER·VICA_USER_DOA_WIDTH 를 같이 쓴다.

# ===== 경비(순찰) 큰 소리 판정 (2026-11-14, src/patrol_sound.py) =====
# 미션 dialog_state 가 patrolling·patrol_dwell 일 때만 reSpeaker 원음(ch1~4) 크기를 잰다. 줄이 없으면 아래 값이다.
# 기준 이상이 0.5초 이어지면 /vica/patrol/event 에 sound 를 한 번 내고 3초 쉰다. 로봇이 말하는 동안은 쉰다.
# (2026-11-14 실기 뒤: 주행 67·정지 53 dB → 둘 다 65 dB, 지속은 0.5초 그대로)
# VICA_PATROL_DB_OFFSET=107.5   # dBFS 에 더할 값 — 11-11 폰 소음계 60 dB ↔ 원음 −47.5 dBFS. 마이크·장착이 바뀌면 다시 맞춘다
# VICA_PATROL_DB_MOVING=65      # patrolling(주행 중) 기준 dB
# VICA_PATROL_DB_STOPPED=65     # patrol_dwell(지점 정지)이 1초 이어진 뒤 기준 dB

# ===== 소프트웨어 에코 제거 (2026-11-18, src/echo_cancel.py) =====
# 스피커 소리를 기준 신호로 마이크 ch0 에서 빼 준다. 끄려면 off 로 두거나 줄을 지우고 음성 노드를 재시작한다.
# VICA_SW_AEC=off           # off | log | on — 기본 off(기존 동작 그대로)
# VICA_SW_AEC_DELAY_MS=100  # 기준 신호 지연(ms)
# VICA_SW_AEC_TAIL_MS=256   # 에코 꼬리 길이(ms)
# 줄임 기록: ~/vica_data/aec_log/YYYYMMDD.jsonl (log·on 일 때 로봇 말 덩어리마다 한 줄)

# ===== 음성 시설 예약 — LLM 도구 호출 (2026-11-18, src/tool_calls.py · src/reservation_flow.py) =====
# 외부 API 두 경로에만 도구(set_intent · reserve_facility)를 준다. 로컬 폴백에는 주지 않는다.
# 둘 다 off 면 예전 동작 그대로다. 바꾼 뒤 음성 노드(LLM · TTS)를 재시작한다.
# VICA_TOOLS_TEXT=off        # off | on — 글자 경로(VICA_LLM_PROVIDER=openai 일 때만 적용)
# VICA_TOOLS_AUDIO=off       # off | on — 소리 경로(Realtime)
# VICA_RESERVATION_DIR=~/vica_data/reservations   # 예약 저장 폴더(reservations.json · 시설 목록 facilities.yaml)

# ---- 의도 재단 (2026-11-20 설계 voice-principles-intent-recut) ----
# on 이면 "나에게 한 말이 아님"(not_for_robot)·"대화 끝내기"(dismiss)를 가르고, 되묻는 문장을 LLM 이 짓지 않고 코드 틀에서 만든다.
# 로컬(Ollama)이 답하는 호출에는 실리지 않는다(외부 API 경로만).
# VICA_RECUT=off             # off | on — 바꾼 뒤 음성 노드(LLM)를 재시작한다

# ---- 대답 칸 (2026-11-18 설계 answer-interpretation · 2026-11-20 voice-principles-intent-recut) ----
# on 이면 로봇이 물은 질문(/vica/question)의 대답 값(answer)을 메시지에 실어 미션에 보낸다. 일시정지 중 "다시 가자"는
# 음성이 묻지 않고 그대로 보내 미션이 "다시 출발할까요?"를 묻게 한다.
# 미션 파라미터 answer_field 와 함께 켠다 — 미션이 옛 설치본이면 확인 없이 다시 출발한다. VICA_RECUT=on 위에서 켠다.
# 다섯 개(VICA_RECUT·VICA_ANSWER + 미션 answer_field·reask_ladder·wake_revive)는 한 묶음으로 켠다 — 음성 쪽 스위치(VICA_RECUT·VICA_ANSWER·VICA_TALK)가 어긋나면 음성 노드가, 미션 쪽 셋이 어긋나면 미션 노드가 기동할 때 경고 한 줄을 낸다(두 노드는 서로의 값을 모른다).
# VICA_ANSWER=off            # off | on — 바꾼 뒤 음성 노드(LLM)를 재시작한다
# VICA_ANSWER_LOCAL=off      # off | on — 켜면 로컬(Ollama) 모델에도 질문 줄·대답 칸을 준다. 끄면 규칙이 정한 대답(네/아니요·분)만 싣는다. VICA_ANSWER=on 일 때만 뜻이 있다(2026-11-21)
# VICA_TALK=off              # off | on — 켜면 "다시 말해줘"·"어디 갈 수 있어?"를 정해진 문장으로, 가벼운 말·비카에 대한 물음에 한 문장으로 답한다. VICA_RECUT=on·VICA_ANSWER=on 이 함께 있어야 한다(2026-11-21)
