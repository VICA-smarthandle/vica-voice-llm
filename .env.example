# VICA 환경변수 템플릿. 실제 값은 .env 에 넣는다 (git 에 올리지 않음).

# ===== LLM (기본: Ollama Cloud — Jetson 온디바이스에서도 주 모델로 사용) =====
OLLAMA_HOST=https://ollama.com
VICA_LLM_MODEL=gemma4:cloud
OLLAMA_API_KEY=여기에_ollama_cloud_키

# ===== (선택) 오프라인/폴백용 로컬 Ollama — 위 3줄 대신 아래로 =====
# OLLAMA_HOST=http://localhost:11434
# VICA_LLM_MODEL=gemma4:e2b
# (로컬 Ollama 는 인증이 없으므로 OLLAMA_API_KEY 를 비워두거나 지운다)

# ===== (선택) OpenAI 백엔드 — 2026-08-15 실측 근거로 도입 검토 중 =====
# (VICA_LLM_MODEL 은 ollama 전용이라 그대로 둬도 된다. openai 모델은 아래 변수)
# VICA_LLM_PROVIDER=openai
# VICA_OPENAI_MODEL=gpt-5.4-mini
# OPENAI_API_KEY=여기에_openai_키

# ===== (선택) 로컬 폴백 — 클라우드가 닿지 않으면 젯슨 안의 Ollama 모델로 자동 전환 =====
# 비우면 폴백이 꺼진다(클라우드 실패 = 고정 멘트). 모델은 scripts/setup_local_llm.sh 로 만든다.
# VICA_LLM_FALLBACK_MODEL=gemma4-e2b-text
# VICA_LLM_FALLBACK_HOST=http://localhost:11434
# VICA_LLM_CLOUD_TIMEOUT=6          # 초. 폴백이 켜졌을 때만 적용, 재시도 없음
# VICA_LLM_CLOUD_PROBE_SEC=30       # 로컬 상태에서 클라우드 확인 간격(초)
# VICA_LLM_LOCAL_TIMEOUT=45          # 초. 로컬 Ollama 호출 상한

# ===== (실험) 소리→의도 직행 — Realtime 이 발화 소리에서 바로 의도를 정한다 (2026-09-20) =====
# VICA_INTENT_INPUT=audio              # text(기본)=지금 방식. audio=Realtime 직행 + 텍스트 경로는 실패 때 예비
# VICA_REALTIME_MODEL=gpt-realtime-2.1-mini
# VICA_REALTIME_TIMEOUT=8              # 초. 넘기면 그 발화는 텍스트 경로가 처리
# VICA_AB_SHADOW=on                    # 기본 꺼짐. 켜면 같은 발화를 텍스트 경로(GPT)로도 판단해 [A/B] 로그에 비교를 남긴다

# ===== 실행 옵션 (main.py) =====
# VICA_TTS=1   # 음성 출력 켜기 (0 이면 텍스트만)
# VICA_STT=0   # 마이크 입력 켜기 (1 이면 STT)

# ===== STT(whisper) 옵션 (기본값은 Jetson 온디바이스 GPU) =====
# VICA_STT_MODEL=small       # tiny/base/small/medium (클수록 정확·느림)
# VICA_STT_DEVICE=cuda       # 기본 cuda. CUDA 미가용 시 자동 CPU 폴백
# VICA_STT_COMPUTE=float16   # 기본 float16. CPU 폴백 시 int8 권장

# 건물 디렉터리(다른 층 장소, P1). 없으면 모델은 이 층만 안다.
VICA_DIRECTORY_YAML=~/vica_data/destinations/directory.yaml

# ===== 호출 방향 회전 ("비카야" 쪽으로 몸 돌리기, docs/beamforming_doa_facts.md) =====
# 기본 off (2026-10-06 팀 요청 — 마이크 잡음이 강한 곳에서 방향이 틀려 엉뚱한 쪽으로 돌았다).
# on 이면 호출 방향을 미션에 보내 그쪽으로 돈다(손잡이 쪽이면 돌지 않고 바로 질문).
# VICA_WAKE_DOA_TURN=off

# ===== 사람 접근 차임 (2026-10-07) =====
# 시각장애인에게 다가가는 동안(미션 dialog_state=approaching) 2초마다 종 두 음 "딩—동↗".
# 첫 인사 "동행로봇 비카가 다가가고 있어요"는 미션이 말한다. off 면 차임만 끈다.
# VICA_APPROACH_CHIME=on
# 차임 최고점(dBFS). 말은 -3. 크면 -9, 작으면 -15 처럼 현장에서 맞춘다.
# VICA_APPROACH_CHIME_DBFS=-12

# ===== "비카야" 응답 주체 (2026-10-07, 호출 반응표) =====
# on(기본): 이 저장소는 호출만 알리고, 미션이 상태를 보고 "네?"·대답 여부를 정한다
# (/vica/wake_reply listen·ignore). 미션 저장소와 같은 날 올린다.
# off: 옛 방식 — 웨이크워드 노드가 상태와 상관없이 직접 "네?"를 하고 듣는다(미션을 옛 판으로 돌릴 때).
# VICA_WAKE_BY_MISSION=on
# 미션 판정을 기다리는 상한(초). 넘기면 미션이 멈춘 것으로 보고 호출 창의 말을 버린다.
# VICA_WAKE_REPLY_TIMEOUT_SEC=6.0
